# OENPC-WEB 应用服务（B 机 172.19.229.191 / systemd）
#
# 安装：
#   sudo cp deploy/oenpc-web-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oenpc-web-server
#
# 日志：
#   sudo journalctl -u oenpc-web-server -f

[Unit]
Description=OENPC-WEB 应用服务（Fastify）
Documentation=file:/opt/oenpc-web/docs/部署说明.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oenpc-web
Group=oenpc-web

# ★★ 关键：应用**在源码树里运行**，而不是把 dist 拷到一个独立目录。
#
# 原因是 pnpm 的依赖布局：`apps/server/node_modules/` 里全是**符号链接**
# （fastify、@oenpc-web/shared 等），真正的包在仓库根的 `node_modules/.pnpm`。
# 而编译产物在运行时**确实**会 `import '@oenpc-web/shared'`，它必须解析到
# `packages/shared/dist/index.js`。
#
# 所以只把 dist 与 apps/server/node_modules 拷出去是**跑不起来**的：
#   · 子包 node_modules 里的链接指向根 .pnpm，脱离仓库即失效；
#   · 从 Windows 拷过来的链接是绝对路径，到了 Linux 直接断。
# → 正确做法：整份源码放上去，在服务器上 `pnpm install` + `pnpm build`。
WorkingDirectory=/opt/oenpc-web/apps/server

# 配置从文件读，不要把内容写进本单元（单元文件常被复制、常进版本库）
EnvironmentFile=/opt/oenpc-web/apps/server/.env
Environment=NODE_ENV=production

ExecStart=/usr/bin/node dist/index.js

# ★ 必须处理 SIGTERM（dist/index.js 里已实现）：
#   直接 SIGKILL 会在 SQLite 留下 -wal 文件，并让 A 机 nginx 把连接断成 502。
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=always
RestartSec=3

# ── 基础加固 ──
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# ProtectSystem=strict 会把整个文件系统挂成只读，所以要显式放开需要写的路径。
#
# **只放开数据目录** —— 服务只需要读代码、写 data/。
# 早期版本还放开了 /opt/oenpc-web（整棵仓库），那既无必要也削弱了沙箱：
# 应用没有任何理由去写自己的源码或 .git。
ReadWritePaths=/opt/oenpc-web/data

# ── 资源上限 ──
MemoryMax=1G

[Install]
WantedBy=multi-user.target
