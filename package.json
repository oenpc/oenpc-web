{
  "name": "oenpc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用型企业外贸展示网站 —— 前台 SSG + 后台 SPA + Fastify 应用服务；开发规范遵循 STRATA",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "strata:selftest": "node strata/checks/selftest.mjs",
    "strata:check": "node strata/checks/run-all.mjs",
    "strata:measure": "node strata/measure-repo.mjs --root . --layers routes,core,services,repositories,db,views,components,stores,api,locales,contract --domains products,content,channels,inquiry,media,site,reports,audit,auth,common,ui",
    "strata:measure:index": "node strata/measure-index.mjs",
    "dev:server": "pnpm --filter @oenpc-web/server dev",
    "build": "pnpm --filter @oenpc-web/shared --filter @oenpc-web/server build",
    "build:web": "pnpm --filter @oenpc-web/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && node --test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
