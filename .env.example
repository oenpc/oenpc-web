# 运行时配置样例 —— 复制成 .env 并按环境填写。
# .env 已被 .gitignore 忽略；本文件（.env.example）入库。
#
# ⚠️ 这些是**服务端**（B 机）的配置。
#    站点的 API 基址**不属于**构建期变量 —— 它必须在运行时注入，
#    否则同一份前端产物无法在测试/生产复用（见约束 runtime-config）。

# 监听地址。默认只监听回环；对公网暴露应由 A 机 nginx 反代，不要直接 0.0.0.0 裸奔。
OENPC_WEB_HOST=127.0.0.1
OENPC_WEB_PORT=3900

# SQLite 数据库文件。相对路径按**进程工作目录**解析 ——
# 测试要隔离必须传绝对路径，否则会写进仓库的 data/ 里。
OENPC_WEB_DB_PATH=data/oenpc-web.db

# 媒体文件目录（产品图 / Banner）。预留对象存储时替换这一处的实现。
OENPC_WEB_MEDIA_DIR=data/media

# 日志级别：debug | info | warn | error
OENPC_WEB_LOG_LEVEL=info

# 站点默认时区，用于**后台展示**（存储一律 UTC，这里只影响渲染）。
OENPC_WEB_DEFAULT_TIMEZONE=Asia/Shanghai

# 公开站点根地址，用于生成绝对 URL（sitemap / hreflang / 结构化数据）。
OENPC_WEB_SITE_URL=http://localhost:3900

# 可信反向代理（A 机 nginx）。逗号分隔的地址或 CIDR。
#
# 生产**必须**配置成 A 机的地址，否则：
#   · 日志里所有访客都是同一个 IP；
#   · 登录限流会把全站用户当成同一个人 —— 一次爆破就把所有人一起封了。
#
# 不要写 true（信任一切）：客户端可以伪造 X-Forwarded-For 绕过限流。
# 直连开发时留空即可。
OENPC_WEB_TRUSTED_PROXY=
