# OENPC-WEB 生产配置（B 机 172.19.229.191）
#
# 安装位置：/opt/oenpc-web/apps/server/.env
#    sudo cp deploy/env.production.example /opt/oenpc-web/apps/server/.env
#    sudo chmod 600 /opt/oenpc-web/apps/server/.env
#
# 本文件按"两台内网机器、暂无域名"的实际拓扑填好，按注释核对即可。

# ★★★ 必须是 B 机的内网地址，不能是 127.0.0.1 ★★★
#
# A 机（172.19.3.47）是**另一台主机**，连不上 B 的回环地址。
# 填 127.0.0.1 时，本机 curl 一切正常，但 A 机 nginx 一律 502 ——
# 而 502 通常被当成"应用挂了"，排查方向完全错。
#
# 也**不要**用 0.0.0.0：那会把 3900 暴露到所有可达网络。
#
# ⚠ 副作用：绑了具体地址后，**回环上就没有服务**了。
#   所以在 B 机上自检、以及构建前台时，都要用内网地址而不是 127.0.0.1：
#     curl http://172.19.229.191:3900/api/health
#     OENPC_WEB_API_BASE=http://172.19.229.191:3900 pnpm build:web
OENPC_WEB_HOST=172.19.229.191
OENPC_WEB_PORT=3900

# 运行期数据。放在**仓库之外**（/opt/oenpc-web/data），这样
# `git pull` 升级代码时不可能碰到它。
#
# ★ 这两个目录不随代码发布更新，**升级时千万不要删**。
#   路径用绝对路径，不要依赖 cwd —— 见 config.ts 关于"相对路径按 cwd 解析"的说明。
OENPC_WEB_DB_PATH=/opt/oenpc-web/data/oenpc-web.db
OENPC_WEB_MEDIA_DIR=/opt/oenpc-web/data/media

# 后台 SPA 产物目录（相对路径按**服务的工作目录**解析，默认 apps/admin/dist）。
# 按源码树部署（/opt/oenpc-web）时无需改动 —— 那正是 pnpm build 的产物位置。
# 设成空串表示本进程不提供后台界面，只提供 API 与媒体。
OENPC_WEB_ADMIN_DIR=apps/admin/dist

OENPC_WEB_LOG_LEVEL=info
OENPC_WEB_DEFAULT_TIMEZONE=Asia/Shanghai

# ★ 公开站点根地址。它是**构建期**烧进静态 HTML 的 ——
#   canonical / hreflang / sitemap 全部用它生成绝对地址。
#
#   当前用 A 机地址（浏览器访问的就是它）。将来绑了域名，要：
#     1. 改这一项   2. 改 nginx 的 server_name   3. **重新构建前台**（pnpm build:web）
#   只改前两项而不重建，页面里的 canonical 与 hreflang 仍指向旧地址 ——
#   搜索引擎会认为这些页面是重复内容，而且不会有任何报错。
OENPC_WEB_SITE_URL=http://172.19.3.47

# ★ 可信反向代理 = **A 机的地址**。
#
# 不配的后果很具体：应用看到的每个请求来源都是 A 机内网 IP，于是
#   · 日志里所有访客是同一个 IP，排查攻击来源完全无用；
#   · 登录限流按 IP 计数 → 退化成"限流全站"，一次暴力破解把所有管理员一起锁在门外。
#
# 绝对不要填 true（信任一切）：客户端可伪造 X-Forwarded-For 绕过限流。
# 多个代理用逗号分隔：172.19.3.47,172.19.3.48
OENPC_WEB_TRUSTED_PROXY=172.19.3.47
